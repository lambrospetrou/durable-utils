{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        // Runtime types come from `./worker-configuration.d.ts` (generated by `wrangler types`).
        // Do NOT add `@cloudflare/workers-types` here: two copies of the Workers types in the
        // same program are structurally different and do not typecheck against each other.
        "types": [
            "@cloudflare/vitest-plugin/types" // provides `cloudflare:test` and `cloudflare:workers` types
        ],
        // Tests import from `../src`, so the root `rootDir` of `src` does not apply here.
        // Nothing is emitted for the tests, they only get typechecked.
        "rootDir": "..",
        "noEmit": true
    },
    "include": ["./**/*.ts", "./worker-configuration.d.ts"],
    "exclude": ["node_modules", "dist"]
}
